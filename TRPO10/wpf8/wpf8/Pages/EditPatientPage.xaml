<Page x:Class="wpf8.Pages.EditPatientPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:wpf8.Pages"
      xmlns:Valid="clr-namespace:wpf8.Validatuons"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="EditPatientPage">


  
    
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Style="{StaticResource qw}">
            <TextBlock Text="Редактирование пациента" />
            <TextBlock x:Name="PatientIdText" />
        </StackPanel>

        <StackPanel Grid.Row="1" Style="{StaticResource qw}">
            <Label Content="Фамилия:"/>
            
            <TextBox x:Name="LastNameTextBox">
                <TextBox.Text>
                    <Binding Path="Pat.LastName" UpdateSourceTrigger="PropertyChanged">
                        <Binding.ValidationRules>
                            <Valid:SurnameValidator/>
                        </Binding.ValidationRules>
                    </Binding>
                </TextBox.Text>
            </TextBox>
            <ItemsControl Foreground="Red"
FontSize="12"
ItemsSource="{Binding ElementName=LastNameTextBox, Path=
(Validation.Errors)}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding ErrorContent}" TextWrapping="Wrap"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>


            <Label Content="Имя:"/>
            <TextBox x:Name="NameTextBox">
                <TextBox.Text>
                    <Binding Path="Pat.Name" UpdateSourceTrigger="PropertyChanged">
                        <Binding.ValidationRules>
                            <Valid:NameValidator/>
                        </Binding.ValidationRules>
                    </Binding>
                </TextBox.Text>
            </TextBox>
            <ItemsControl Foreground="Red"
FontSize="12"
ItemsSource="{Binding ElementName=NameTextBox, Path=
(Validation.Errors)}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding ErrorContent}" TextWrapping="Wrap"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Label Content="Отчество:"/>
            <TextBox x:Name="MiddleNameTextBox">
                <TextBox.Text>
                    <Binding Path="Pat.MiddleName" UpdateSourceTrigger="PropertyChanged">
                        <Binding.ValidationRules>
                            <Valid:OTCHConverter/>
                        </Binding.ValidationRules>
                    </Binding>
                </TextBox.Text>
            </TextBox>
            <ItemsControl Foreground="Red"
     FontSize="12"
     ItemsSource="{Binding ElementName=MiddleNameTextBox, Path=
     (Validation.Errors)}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding ErrorContent}" TextWrapping="Wrap"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Label Content="Дата рождения:"/>
            <DatePicker x:Name="BirthdayDatePicker"/>

            <Label Content="Телефон:"/>
            <TextBox x:Name="PhoneTextBox">
                <TextBox.Text>
                    <Binding Path="Pat.PhoneNumber" UpdateSourceTrigger="PropertyChanged">
                        <Binding.ValidationRules>
                            <Valid:IsPhone/>
                        </Binding.ValidationRules>
                    </Binding>
                </TextBox.Text>
            </TextBox>
            <ItemsControl Foreground="Red"
                FontSize="12"
                ItemsSource="{Binding ElementName=PhoneTextBox, Path=
                (Validation.Errors)}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding ErrorContent}" TextWrapping="Wrap"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            
        </StackPanel>

        <StackPanel Grid.Row="2" Style="{StaticResource qw}">
            <Button Content="Назад" Click="BackButton_Click"/>
            <Button Content="Сохранить" Click="SaveButton_Click" Style="{StaticResource ADDBTN}"/>
        </StackPanel>
    </Grid>
</Page>
