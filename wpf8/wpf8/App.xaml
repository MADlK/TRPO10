<Application x:Class="wpf8.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:wpf8"
             xmlns:conv="clr-namespace:wpf8.Converters"
             xmlns:Valid="clr-namespace:wpf8.Validatuons"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <conv:SovershConverter x:Key="SovershConverter"/>
            <conv:AgeConverter x:Key="AgeConverter"/>
            <Valid:IsPhone x:Key="IsPhone"/>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ColorsDef.xaml"/>
                <ResourceDictionary Source="BtnStyle.xaml"/>
                <ResourceDictionary Source="STACKPANELSOURCE.xaml"/>
                
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
        
            

        
    </Application.Resources>
    
</Application>
